# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# public autogen
/public/json/categories.json
/public/json/posts.json
/public/json/tags.json
/public/generated/

# 暂时取消github action
/.github/
